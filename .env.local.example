# ── Square (checkout) ─────────────────────────────────────────────────────
# Same production Square account as housecallwebs.com, set as this project's
# own env vars in Vercel. Get these from the Square Developer Dashboard.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# ── Resend (contact form) ─────────────────────────────────────────────────
# Get your API key at https://resend.com → API Keys
RESEND_API_KEY=

# Optional overrides — sensible defaults are set in app/api/contact/route.ts
# From address requires a verified sending domain in Resend. If
# noreply@firewoodwebsite.com isn't verified yet, leave unset to fall back
# to noreply@housecallwebs.com.
# CONTACT_FROM_ADDRESS="Firewood Website <noreply@firewoodwebsite.com>"
# CONTACT_TO_ADDRESS=hello@housecallwebs.com

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://firewoodwebsite.com
